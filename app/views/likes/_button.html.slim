div id=dom_id(micropost, :likes)
  span.likes-count = "#{micropost.likes.size} likes"
  - if logged_in?
    - like = micropost.likes.detect { |item| item.user_id == current_user.id }
    - if like
      = button_to "いいね解除", like_path(like), method: :delete, class: "btn btn-default", aria: { pressed: true }
    - else
      = button_to "いいね", likes_path(micropost_id: micropost.id), class: "btn btn-default", aria: { pressed: false }
